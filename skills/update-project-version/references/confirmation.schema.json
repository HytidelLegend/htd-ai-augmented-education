{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "packet_sha256", "preview_sha256", "confirmed", "confirmed_at"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preview_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confirmed": {"const": true},
    "confirmed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
  }
}
