{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-speech-to-text-output-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "time_unit", "interval_semantics", "duration_ms", "items", "sentences"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "time_unit": {"const": "ms"},
    "interval_semantics": {"const": "[start_ms, end_ms)"},
    "duration_ms": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "minItems": 1},
    "sentences": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
