{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["senses"],
  "properties": {"needsReview": {"type": "boolean"}, "reviewReason": {"type": "string"},
    "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relationDecisions": {"$ref": "#/$defs/relationDecisions"},
    "derivativeDecisions": {"$ref": "#/$defs/derivativeDecisions"},
    "relationSenseMappings": {"type": "array", "items": {"type": "object", "required": ["source", "groupIndex", "senseIndex"],
      "properties": {"source": {"type": "integer", "minimum": 0}, "groupIndex": {"type": "integer", "minimum": 0}, "senseIndex": {"type": "integer", "minimum": 0}}}},
    "relationTypeOverrides": {"type": "array", "items": {"type": "object", "required": ["source", "groupIndex", "word", "type"],
      "properties": {"source": {"type": "integer", "minimum": 0}, "groupIndex": {"type": "integer", "minimum": 0}, "word": {"type": "string"},
        "type": {"enum": ["synonym", "near_synonym", "antonym"]}}}},
    "legacyUsageUpdates": {"$ref": "#/$defs/legacyUsageUpdates"},
    "senses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["partOfSpeech", "definitionZh", "definitionEn", "examples"], "properties": {
    "senseId": {"type": "string"}, "partOfSpeech": {"type": "string"},
    "definitionZh": {"type": "string"}, "definitionEn": {"type": "string"},
    "zhSourceSupported": {"type": "boolean"}, "enSourceSupported": {"type": "boolean"},
    "zhConfidence": {"type": "number"}, "enConfidence": {"type": "number"},
    "zhEvidence": {"$ref": "#/$defs/pointers"}, "enEvidence": {"$ref": "#/$defs/pointers"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["source", "fragment"], "properties": {"source": {"type": "integer", "minimum": 0}, "fragment": {"type": "integer", "minimum": 0}}}},
    "alignmentEvidence": {"$ref": "#/$defs/pointers"},
    "grammarTags": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/shortItem"}]}},
    "registerTags": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"$ref": "#/$defs/shortItem"}]}},
    "examples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shortItem"}},
    "collocations": {"type": "array", "items": {"$ref": "#/$defs/shortItem"}},
    "phrases": {"type": "array", "items": {"$ref": "#/$defs/shortItem"}}
  }}}},
  "$defs": {
    "relationDecisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["candidateId", "action"],
      "properties": {"candidateId": {"type": "string", "pattern": "^rc_[0-9a-f]{20}$"},
        "action": {"enum": ["accept", "reject", "uncertain"]},
        "type": {"enum": ["synonym", "near_synonym", "antonym"]}},
      "allOf": [{"if": {"properties": {"action": {"const": "accept"}}}, "then": {"required": ["type"]}}]
    }},
    "derivativeDecisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["candidateId", "action"],
      "properties": {"candidateId": {"type": "string", "pattern": "^dc_[0-9a-f]{20}$"},
        "action": {"enum": ["direct_derivative", "same_family", "reject", "uncertain"]}}
    }},
    "pointers": {"type": "array", "items": {"type": "object", "required": ["source", "fragment"],
      "properties": {"source": {"type": "integer", "minimum": 0}, "fragment": {"type": "integer", "minimum": 0}}}},
    "shortItem": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1},
      "sourceSupported": {"type": "boolean"}, "confidence": {"type": "number"}, "evidence": {"$ref": "#/$defs/pointers"},
      "translationZh": {"type": "object", "properties": {"text": {"type": "string"},
        "sourceSupported": {"type": "boolean"}, "confidence": {"type": "number"},
        "evidence": {"$ref": "#/$defs/pointers"}}},
      "emphasis": {"$ref": "#/$defs/emphasis"}}},
    "emphasis": {"type": "object", "properties": {
      "en": {"type": "array", "items": {"$ref": "#/$defs/span"}},
      "zh": {"type": "array", "items": {"$ref": "#/$defs/span"}}}},
    "span": {"type": "object", "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}},
    "legacyUsageUpdates": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["itemId", "translationZh", "confidence"],
      "properties": {"itemId": {"type": "string", "pattern": "^i_[0-9a-f]{20}$"},
        "translationZh": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1, "multipleOf": 0.01},
        "zhSpans": {"type": "array", "items": {"$ref": "#/$defs/span"}}}}}
  }
}
