{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learner-profile-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "learner_id", "subjects", "target_exam", "available_periods", "daily_minutes", "learning_style"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "learner_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$"},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "target_exam": {"type": "object", "required": ["name", "date"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "date": {"type": "string", "format": "date"}}},
    "available_periods": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": {"start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}}}},
    "daily_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
    "learning_style": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  }
}
