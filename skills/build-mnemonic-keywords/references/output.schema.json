{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "run_id", "input", "keywords", "memory", "prompt", "self_check", "image", "publication"],
  "properties": {
    "status": {"enum": ["paused", "completed"]},
    "run_id": {"type": "string", "minLength": 1},
    "input": {"type": "object", "required": ["sentence"]},
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["text", "role", "familiar_object", "scene_action"]}},
    "memory": {"type": "object", "required": ["mnemonic", "scene", "sensory_hooks", "order_note"]},
    "prompt": {"type": "object", "required": ["model", "positive_prompt", "negative_prompt", "aspect_ratio"]},
    "self_check": {
      "type": "object",
      "required": ["fit", "reason", "recommendation", "principle_checks"],
      "properties": {
        "fit": {"enum": ["good", "weak", "bad"]},
        "reason": {"type": "string"},
        "recommendation": {"type": "string"},
        "principle_checks": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": true
    },
    "image": {"type": "object"},
    "publication": {"type": "object"}
  },
  "additionalProperties": true
}
