{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tool_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_type": {"enum": ["text", "markdown", "epub", "inline"]},
    "input_file": {"type": "string"},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "content": {"type": "string"},
    "topic": {"type": "string"},
    "requirements": {"type": "object"},
    "essay": {"type": "string"},
    "polished_essay": {"type": "string"},
    "agent_review": {"$ref": "#/$defs/agent_review"},
    "full_score": {"type": "integer", "exclusiveMinimum": 0},
    "target_score": {"type": ["integer", "string"]},
    "target_tolerance": {"type": "integer", "minimum": 0},
    "grade_run_id": {"type": "string", "minLength": 1},
    "feedback": {"type": ["string", "array"]},
    "parent_run_id": {"type": "string", "minLength": 1},
    "output_file": {"type": "string"},
    "tool_name": {"type": "string"},
    "ignore_translation": {"type": "boolean"},
    "replace_existing": {"type": "boolean"}
  },
  "$defs": {
    "organization_analysis": {
      "type": "object",
      "required": ["paragraph_count", "recommended_paragraph_count", "status", "summary", "paragraph_reviews", "logic_issues", "suggestions"],
      "properties": {
        "paragraph_count": {"type": "integer", "minimum": 1},
        "recommended_paragraph_count": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "paragraph_reviews": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["paragraph_index", "role", "status", "evidence"],
            "properties": {
              "paragraph_index": {"type": "integer", "minimum": 1},
              "role": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "missing_roles": {"type": "array", "items": {"type": "string"}},
        "logic_issues": {"type": "array", "items": {"type": "string"}},
        "suggestions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "agent_review": {
      "type": "object",
      "required": ["value", "dimension_scores", "overall_evaluation", "sentence_reviews"],
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "dimension_scores": {"type": "array"},
        "overall_evaluation": {"type": "string", "minLength": 1},
        "organization_analysis": {"$ref": "#/$defs/organization_analysis"},
        "sentence_reviews": {"type": "array"},
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["optimization_index", "summary", "locations"],
            "properties": {
              "optimization_index": {"type": "integer", "minimum": 1},
              "summary": {"type": "string", "minLength": 1},
              "locations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["sentence_index", "original", "revised", "reason"],
                  "properties": {
                    "sentence_index": {"type": "integer", "minimum": 1},
                    "original": {"type": "string", "minLength": 1},
                    "revised": {"type": "string", "minLength": 1},
                    "reason": {"type": "string", "minLength": 1},
                    "issue_type": {"type": "string"},
                    "affected_dimension": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
