{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "skip": {
            "type": "boolean"
          }
        },
        "required": [
          "candidate_id",
          "skip"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "decisions"
  ],
  "additionalProperties": false
}
