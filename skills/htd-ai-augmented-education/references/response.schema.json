{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "htd-ai-augmented-education-response.schema.json",
  "title": "Project Router Response",
  "type": "object",
  "required": ["response_type", "normalized_request", "assumptions", "evidence"],
  "properties": {
    "response_type": {"enum": ["project_info", "task_routing"]},
    "normalized_request": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "relevance"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "relevance": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "answer_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statement", "sources"],
        "properties": {
          "statement": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "normalized_task": {"type": "string", "minLength": 1},
    "skill_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["order", "skill", "purpose", "prerequisite", "source"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "skill": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "prerequisite": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "prompt_example": {
      "type": "object",
      "required": ["objective", "context", "constraints", "acceptance_criteria"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "context": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "uncovered_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"response_type": {"const": "project_info"}}},
      "then": {"required": ["answer_points", "limitations"]}
    },
    {
      "if": {"properties": {"response_type": {"const": "task_routing"}}},
      "then": {"required": ["normalized_task", "skill_sequence", "prompt_example", "uncovered_requirements"]}
    }
  ],
  "additionalProperties": false
}
