{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactive-tutor-request-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "input_paths",
    "interaction_mode"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.0",
        "3.0"
      ]
    },
    "input_paths": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "student_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "teaching_language": {
      "type": [
        "string",
        "null"
      ]
    },
    "interaction_mode": {
      "enum": [
        "file_driven",
        "chat"
      ]
    },
    "counterfactual_mode": {
      "type": "boolean"
    },
    "knowledge_base_mode": {
      "const": "specified_materials"
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "bilingual_glossary": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_dir": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [{"if": {"properties": {"schema_version": {"const": "2.0"}}}, "then": {"properties": {"input_paths": {"minItems": 1}}}}],
  "additionalProperties": false
}
