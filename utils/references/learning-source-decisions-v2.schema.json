{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-source-decisions-v2.schema.json",
  "type": "object",
  "required": ["schema_version", "source_id", "covered_candidate_ids", "items", "relationship_records"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "source_id": {"type": "string", "minLength": 1},
    "covered_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "items": {"type": "array", "items": {"type": "object"}},
    "relationship_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predecessor_ref", "successor_ref", "reason", "evidence_refs", "confidence", "source_ids"],
        "properties": {
          "predecessor_ref": {"type": "string", "minLength": 1},
          "successor_ref": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confidence": {"enum": ["low", "medium", "high"]},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
