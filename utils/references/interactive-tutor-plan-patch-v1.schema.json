  "required": [
    "base_revision",
    "operations"
  ],
  "properties": {
    "base_revision": {
      "type": "integer",
      "minimum": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "enum": [
              "add_chapter",
              "add",
              "update",
              "delete"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
