{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-navigation-v2.schema.json",
  "type": "object",
  "required": ["schema_version", "title", "created_at", "updated_at", "student_profile_ref", "planning_profile", "course_overview", "lesson_generation_policy", "sources", "source_relationships", "stages", "units", "concept_index", "coverage_gaps", "deferred_items"],
  "properties": {
    "schema_version": {"const": "2.0"}, "title": {"type": "string", "minLength": 1}, "created_at": {"type": "string"}, "updated_at": {"type": "string"},
    "student_profile_ref": {"type": ["object", "null"]}, "planning_profile": {"type": "object"},
    "course_overview": {"$ref": "#/$defs/overview"}, "lesson_generation_policy": {"type": "object"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "source_relationships": {"type": "array", "items": {"type": "object"}},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "concept_index": {"type": "object", "additionalProperties": {"type": "string"}},
    "coverage_gaps": {"type": "array", "items": {"type": "object"}},
    "deferred_items": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "overview": {"type": "object", "required": ["purpose", "core_questions", "completion_criteria"], "properties": {"purpose": {"type": "string", "minLength": 1}, "core_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "source": {"type": "object", "required": ["source_id", "path", "sha256", "title", "size_bytes", "author", "edition", "theme", "content_tendency", "scan_confidence"], "properties": {"source_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "title": {"type": "string"}, "size_bytes": {"type": "integer", "minimum": 0}, "author": {"type": "string"}, "edition": {"type": "string"}, "theme": {"type": "string"}, "content_tendency": {"$ref": "#/$defs/strings"}, "scan_confidence": {"type": "string"}}, "additionalProperties": false},
    "module": {"type": "object", "required": ["module_id", "title", "sequence", "overview"], "properties": {"module_id": {"type": "string"}, "title": {"type": "string"}, "sequence": {"type": "integer"}, "overview": {"$ref": "#/$defs/overview"}}, "additionalProperties": false},
    "stage": {"type": "object", "required": ["stage_id", "title", "sequence", "overview", "modules"], "properties": {"stage_id": {"type": "string"}, "title": {"type": "string"}, "sequence": {"type": "integer"}, "overview": {"$ref": "#/$defs/overview"}, "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}}, "additionalProperties": false},
    "conceptRole": {"type": "object", "required": ["concept", "role"], "properties": {"concept": {"type": "string"}, "role": {"enum": ["introduce", "review", "apply", "contrast"]}}, "additionalProperties": false},
    "sourceLocator": {"type": "object", "required": ["source_id", "file", "source_sha256", "heading_text", "heading_level", "heading_occurrence", "parent_heading_chain", "start_line_hint", "end_before_heading", "end_line_hint", "locator_status"], "properties": {"source_id": {"type": "string"}, "file": {"type": "string"}, "source_sha256": {"type": "string"}, "heading_text": {"type": "string"}, "heading_level": {"type": "integer"}, "heading_occurrence": {"type": "integer"}, "parent_heading_chain": {"$ref": "#/$defs/strings"}, "start_line_hint": {"type": "integer"}, "end_before_heading": {"type": ["string", "null"]}, "end_line_hint": {"type": "integer"}, "locator_status": {"type": "string"}}, "additionalProperties": false},
    "unit": {
      "type": "object",
      "required": ["unit_id", "title", "unit_type", "stage", "module", "sequence", "importance", "difficulty", "purpose", "learning_objectives", "prerequisites", "concept_roles", "content_roles", "risk_tags", "teaching_notes", "case_context", "visual_references", "source"],
      "properties": {
        "unit_id": {"type": "string"}, "title": {"type": "string"}, "unit_type": {"enum": ["source_reading", "agent_overview"]},
        "stage": {"type": "string"}, "module": {"type": "string"}, "sequence": {"type": "integer", "minimum": 1},
        "importance": {"type": "string"}, "difficulty": {"type": "string"}, "purpose": {"type": "string"},
        "learning_objectives": {"$ref": "#/$defs/strings"}, "prerequisites": {"$ref": "#/$defs/strings"},
        "concept_roles": {"type": "array", "items": {"$ref": "#/$defs/conceptRole"}}, "content_roles": {"$ref": "#/$defs/strings"},
        "risk_tags": {"$ref": "#/$defs/strings"}, "teaching_notes": {"$ref": "#/$defs/strings"}, "case_context": {"type": ["object", "null"]},
        "visual_references": {"type": "array", "items": {"type": "object"}}, "source": {"oneOf": [{"$ref": "#/$defs/sourceLocator"}, {"type": "null"}]}
      }, "additionalProperties": false
    }
  }
}
