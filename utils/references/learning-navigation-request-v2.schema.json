{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-navigation-request-v2.schema.json",
  "type": "object",
  "required": ["schema_version", "input_paths", "navigation_title", "preview_chars", "max_heading_depth", "max_candidates_per_batch", "max_preview_chars_per_batch", "max_total_preview_chars"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "input_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "navigation_json": {"type": ["string", "null"], "pattern": "\\.json$"}, "navigation_title": {"type": "string", "minLength": 1},
    "student_profile": {"type": ["string", "null"]},
    "preview_chars": {"type": "integer", "minimum": 0, "maximum": 2000},
    "max_heading_depth": {"type": "integer", "minimum": 1, "maximum": 6},
    "max_candidates_per_batch": {"type": "integer", "minimum": 1, "maximum": 100},
    "max_preview_chars_per_batch": {"type": "integer", "minimum": 100, "maximum": 50000},
    "max_total_preview_chars": {"type": "integer", "minimum": 100, "maximum": 500000}
  },
  "additionalProperties": false
}
