{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-loop-resolution-v2.schema.json",
  "type": "object",
  "required": ["schema_version", "graph_revision", "confirmed_by", "actions"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "graph_revision": {"type": "string", "minLength": 1},
    "confirmed_by": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "predecessor_id", "successor_id", "reason"],
        "properties": {
          "action": {"enum": ["remove_requirement", "reverse_requirement"]},
          "predecessor_id": {"type": "string", "minLength": 1},
          "successor_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
