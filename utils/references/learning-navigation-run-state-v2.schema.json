{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-navigation-run-state-v2.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "current_stage", "created_at", "updated_at", "completed_steps", "pending_decisions", "errors"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared", "source_navigation_fragment_required", "source_navigation_fragments_required", "all_source_navigation_fragments_ready", "semantic_decisions_required", "ordering_decision_required", "awaiting_loop_resolution", "awaiting_approval", "completed", "paused_source_conflict", "paused_input_changed", "paused_error"]},
    "current_stage": {"enum": ["prepared", "source_navigation_fragment_required", "source_navigation_fragments_required", "all_source_navigation_fragments_ready", "semantic_decisions_required", "ordering_decision_required", "awaiting_loop_resolution", "awaiting_approval", "completed", "paused_source_conflict", "paused_input_changed", "paused_error"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "completed_steps": {"type": "array", "items": {"type": "string"}},
    "pending_decisions": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "request_path": {"type": "string"},
    "navigation_json": {"type": "string"},
    "navigation_markdown": {"type": "string"},
    "expected_navigation_sha256": {"type": ["string", "null"]},
    "expected_navigation_markdown_sha256": {"type": ["string", "null"]},
    "expected_source_fragment_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "student_profile_hash": {"type": ["string", "null"]},
    "preview_sha256": {"type": ["string", "null"]},
    "confirmed_by": {"type": ["string", "null"]},
    "current_source_id": {"type": ["string", "null"]},
    "source_queue": {"type": "array", "items": {"type": "string"}},
    "completed_source_ids": {"type": "array", "items": {"type": "string"}},
    "source_navigation_fragments": {"type": "array", "items": {"type": "object"}},
    "graph_revision": {"type": ["string", "null"]},
    "resume_stage": {"type": ["string", "null"]},
    "resume_from_status": {"type": ["string", "null"]},
    "last_decisions_path": {"type": ["string", "null"]},
    "last_ordering_path": {"type": ["string", "null"]},
    "last_loop_resolution_path": {"type": ["string", "null"]},
    "last_source_decisions_path": {"type": ["string", "null"]},
    "last_source_decisions_id": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
