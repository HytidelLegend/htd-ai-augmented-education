{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "fingerprint",
    "short_complete_reason",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "short_complete_reason": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "judgment",
          "reason"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "judgment": {
            "enum": [
              "sufficient",
              "needs_expansion"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
