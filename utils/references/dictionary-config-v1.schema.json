{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surfaceRaised": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "mutedText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "hover": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "selected": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "disabled": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "surfaceRaised",
        "text",
        "mutedText",
        "border",
        "hover",
        "selected",
        "disabled",
        "error",
        "success"
      ]
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unfamiliar": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "seen": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "familiar": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "outsideStage": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "unfamiliar",
        "seen",
        "familiar",
        "outsideStage"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initializeOnEnter": {
          "type": "boolean"
        },
        "family": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "synonym": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "near_synonym": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "antonym": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "spelling_similar": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "synonym",
            "near_synonym",
            "antonym",
            "spelling_similar"
          ]
        },
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "springStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "repulsionStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "familyNonMemberRepulsionStrength": {
              "type": "number",
              "minimum": 0,
              "maximum": 5000
            },
            "damping": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "restLength": {
              "type": "number",
              "minimum": 30,
              "maximum": 500
            },
            "familyNodeGap": {
              "type": "number",
              "minimum": 0,
              "maximum": 64
            }
          },
          "required": [
            "springStrength",
            "repulsionStrength",
            "familyNonMemberRepulsionStrength",
            "damping",
            "restLength",
            "familyNodeGap"
          ]
        }
      },
      "required": [
        "initializeOnEnter",
        "family",
        "relations",
        "physics"
      ]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activeText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "inactiveText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "focus": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "sliderTrack": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "activeText",
        "inactiveText",
        "focus",
        "sliderTrack"
      ]
    },
    "favorites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "star": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "star"
      ]
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wordsPerPage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "wordsPerPage"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "ui",
    "learning",
    "graph",
    "controls",
    "favorites",
    "study"
  ]
}
