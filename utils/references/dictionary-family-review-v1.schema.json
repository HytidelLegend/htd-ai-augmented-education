{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "wordId", "reviews"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "wordId": {"type": "string", "pattern": "^w_[0-9a-f]{20}$"},
    "reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["field", "verificationStatus", "outcome", "sourceRunId", "candidateIds", "reviewRef"],
      "properties": {
        "field": {"enum": ["inflections", "derivatives"]},
        "verificationStatus": {"const": "automatic_passed"},
        "outcome": {"enum": ["published", "no_supported_candidate"]},
        "sourceRunId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}(?:_[0-9]+)?$"},
        "candidateIds": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^fc_[0-9a-f]{20}$"}},
        "reviewRef": {"type": "object", "additionalProperties": false,
          "required": ["runId", "decisionDigest", "evidenceDigest", "reviewedAt"],
          "properties": {
            "runId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}(?:_[0-9]+)?$"},
            "decisionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "evidenceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "reviewedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"}
          }}
      }
    }}
  }
}
