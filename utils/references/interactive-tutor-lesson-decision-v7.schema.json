{
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "overview",
    "key_points",
    "formulas",
    "teaching_points",
    "guiding_questions",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "7.0"
    },
    "lesson_id": {
      "type": "string"
    },
    "overview": {
      "type": "string",
      "minLength": 1
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teaching_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unit_id",
          "text",
          "evidence_ids",
          "external_explanation",
          "blocks"
        ],
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 0
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "external_explanation": {
            "type": "boolean"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "block_id",
                "kind",
                "objective_indices",
                "point_ids",
                "coverage",
                "parts"
              ],
              "additionalProperties": false,
              "properties": {
                "block_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "kind": {
                  "enum": [
                    "explanation",
                    "steps",
                    "example",
                    "boundary",
                    "application"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 0
                },
                "objective_indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uniqueItems": true
                },
                "point_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "coverage": {
                  "enum": [
                    "mentioned",
                    "explained"
                  ]
                },
                "parts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "text"
                        ],
                        "properties": {
                          "type": {
                            "const": "paragraph"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "items"
                        ],
                        "properties": {
                          "type": {
                            "const": "unordered_list"
                          },
                          "items": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "items"
                        ],
                        "properties": {
                          "type": {
                            "const": "ordered_list"
                          },
                          "items": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "latex"
                        ],
                        "properties": {
                          "type": {
                            "const": "formula"
                          },
                          "latex": {
                            "type": "string",
                            "minLength": 1
                          },
                          "caption": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "code"
                        ],
                        "properties": {
                          "type": {
                            "const": "code"
                          },
                          "code": {
                            "type": "string",
                            "minLength": 1
                          },
                          "caption": {
                            "type": "string"
                          },
                          "language": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_+.-]*$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "type",
                          "text",
                          "source"
                        ],
                        "properties": {
                          "type": {
                            "const": "quote"
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source": {
                            "type": "string",
                            "minLength": 1
                          },
                          "url": {
                            "type": "string",
                            "pattern": "^https?://[^\\s<>]+$"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "evidence_id",
                          "edited"
                        ],
                        "properties": {
                          "type": {
                            "const": "material_quote"
                          },
                          "evidence_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "edited": {
                            "type": "boolean"
                          },
                          "edited_text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "resolved": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "text",
                              "source",
                              "evidence"
                            ],
                            "properties": {
                              "text": {
                                "type": "string",
                                "minLength": 1
                              },
                              "source": {
                                "type": "string",
                                "minLength": 1
                              },
                              "evidence": {
                                "type": "object"
                              }
                            }
                          }
                        },
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "edited": {
                                  "const": true
                                }
                              }
                            },
                            "then": {
                              "required": [
                                "edited_text"
                              ]
                            },
                            "else": {
                              "not": {
                                "required": [
                                  "edited_text"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "guiding_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "type",
          "unit_ids",
          "prompt",
          "options",
          "correct_index",
          "reference_answer",
          "expected_points",
          "evidence_ids"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "multiple_choice",
              "open_ended"
            ]
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reference_answer": {
            "type": "string",
            "minLength": 1
          },
          "expected_points": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "reuse_review": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "history_id",
                "reason",
                "purpose"
              ],
              "additionalProperties": false,
              "properties": {
                "history_id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "enum": [
                    "retest",
                    "different_task"
                  ]
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "adaptation_applied": {
      "type": "object",
      "required": [
        "feedback_id",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "feedback_id": {
          "type": "string"
        },
        "changes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
